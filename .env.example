# Copie para .env e preencha. O .env esta no .gitignore desde o commit inicial
# e nunca deve ser versionado — este repositorio e publico.

# Evolution API (WhatsApp). Stack em D:\projeto-engajamento
EVOLUTION_URL=http://localhost:8080
EVOLUTION_INSTANCIA=teste
EVOLUTION_APIKEY=

# Destino da notificacao: so digitos, com codigo do pais e DDD.
# Formato 55DDDNNNNNNNNN — sem +, sem espaco, sem parentese, sem hifen.
WHATSAPP_DESTINO=

# Postgres (Etapa 2). O container nao publica porta no host: todo acesso
# e por docker exec, ou pelo nome de servico `postgres` dentro da rede Docker.
PGCONTAINER=projeto-engajamento-postgres-1
PGUSER=engajamento_admin
PGDATABASE=job_hunt_db
