# Copie para .env e preencha. O .env esta no .gitignore desde o commit inicial
# e nunca deve ser versionado — este repositorio e publico.
#
# Ha dois modos de rodar, e o codigo nao sabe a diferenca: quem decide e este
# arquivo.
#
#   A) Stack proprio (docker compose up -d)  — autocontido, recomendado para
#      quem clona o repositorio.
#   B) Reaproveitando um Postgres/Evolution que ja existe na maquina, apenas
#      apontando PGCONTAINER e EVOLUTION_* para ele.

# ---------------------------------------------------------------- Evolution
# Modo A: http://localhost:8081 (porta do docker-compose.yml deste repo)
# Modo B: a porta do stack que voce ja usa
EVOLUTION_URL=http://localhost:8081
EVOLUTION_INSTANCIA=radar
EVOLUTION_APIKEY=

# Destino da notificacao: so digitos, com codigo do pais e DDD.
# Formato 55DDDNNNNNNNNN — sem +, sem espaco, sem parentese, sem hifen.
# O WhatsApp aceita 12 ou 13 digitos: numeros antigos nao tem o nono digito.
WHATSAPP_DESTINO=

# ----------------------------------------------------------------- Postgres
# O coletor fala com o banco por `docker exec`, nao por TCP: no ambiente de
# desenvolvimento o Postgres reaproveitado nao publica porta no host.
# Modo A: radar-postgres        Modo B: o nome do container que ja roda
PGCONTAINER=radar-postgres
PGUSER=radar
PGDATABASE=job_hunt_db

# ------------------------------------------- so para o docker-compose.yml
# Ignorados no modo B. RADAR_PGPASSWORD e obrigatorio para subir o stack.
RADAR_PGUSER=radar
RADAR_PGPASSWORD=
RADAR_PGPORT=5434
RADAR_EVOLUTION_PORT=8081
RADAR_N8N_PORT=5679

# ------------------------------------------------------------------ Anthropic
# Usada pelo dossie.py para gerar curriculo personalizado e mensagem ao RH.
# Chave em console.anthropic.com. O radar (coletar.py) NAO precisa dela.
ANTHROPIC_API_KEY=
